rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
//  Firestore Security Rules — Futbols PWA
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidStats(stats) {
      return stats is map
        && stats.goals is int && stats.goals >= 0
        && stats.assists is int && stats.assists >= 0
        && stats.matchesPlayed is int && stats.matchesPlayed >= 0;
    }

    // ── Colección: users ──────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles (para el ranking).
    // Solo el propio usuario puede actualizar su perfil (excepto stats, que
    // solo se actualizan desde Cloud Functions con Admin SDK).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // El propio usuario puede actualizar su perfil (no stats).
      // Los admins pueden actualizar el campo 'role' de cualquier usuario.
      allow update: if (
        isOwner(userId)
        && !('stats' in request.resource.data.diff(resource.data).affectedKeys())
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
      );
      // Las stats solo las puede modificar el Admin SDK (Cloud Functions)
      allow delete: if false;
    }

    // ── Colección: matches ────────────────────────────────────────────────────
    match /matches/{matchId} {
      // Cualquier autenticado puede leer partidos
      allow read: if isAuthenticated();

      // Solo admins crean o modifican la configuración del partido
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (
                      // Los usuarios solo pueden modificar currentPlayers y status
                      // (a través de la transacción del composable)
                      isAuthenticated()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['currentPlayers', 'status', 'updatedAt'])
                    );
      allow delete: if isAdmin();

      // ── Subcolección: registrations ────────────────────────────────────────
      match /registrations/{userId} {
        // Cualquier autenticado puede leer la lista de inscriptos
        allow read: if isAuthenticated();

        // Un usuario solo puede inscribirse a sí mismo
        allow create: if isOwner(userId)
                      && request.resource.data.userId == request.auth.uid;

        // Puede actualizar (ej: team asignado por admin)
        allow update: if isAdmin()
                      || isOwner(userId);

        // Puede cancelar su propia inscripción
        allow delete: if isOwner(userId) || isAdmin();
      }

      // ── Subcolección: playerStats ──────────────────────────────────────────
      match /playerStats/{userId} {
        // Lectura pública para autenticados
        allow read: if isAuthenticated();

        // Solo el Admin SDK (Cloud Functions) escribe stats
        // En producción, esto es manejado por Cloud Functions con Admin SDK
        // que bypasea las rules. Aquí bloqueamos acceso directo.
        allow write: if false;
      }
    }

    // ── Colección: groups ─────────────────────────────────────────────────────
    match /groups/{groupId} {
      // Cualquier usuario autenticado puede leer grupos (para búsqueda por nombre)
      allow read: if isAuthenticated();

      // Cualquier usuario autenticado puede crear un grupo
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;

      // Solo owner/admin del grupo puede actualizar la configuración del grupo,
      // O cualquier autenticado puede actualizar solo memberCount+updatedAt
      // (necesario para join/leave via cliente)
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
          in ['owner', 'admin']
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberCount', 'updatedAt'])
      );

      allow delete: if isAuthenticated()
                    && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';

      // ── Subcolección: members ────────────────────────────────────────────
      match /members/{userId} {
        // Cualquier autenticado puede leer miembros (lista pública del grupo)
        allow read: if isAuthenticated();

        // Un usuario puede añadirse a sí mismo (unirse por invite code)
        // o un admin/owner puede añadir a alguien (al aceptar solicitud)
        allow create: if isOwner(userId)
                      || (isAuthenticated()
                          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                               in ['owner', 'admin']);

        // Solo admin/owner puede cambiar el rol de un miembro
        allow update: if isAuthenticated()
                      && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                           in ['owner', 'admin'];

        // Un miembro puede eliminarse a sí mismo (salir), o admin/owner puede expulsar
        allow delete: if isOwner(userId)
                      || (isAuthenticated()
                          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                               in ['owner', 'admin']);
      }

      // ── Subcolección: joinRequests ───────────────────────────────────────
      match /joinRequests/{userId} {
        // El propio solicitante puede leer su solicitud;
        // admin/owner pueden leer todas las solicitudes
        allow read: if isOwner(userId)
                    || (isAuthenticated()
                        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                             in ['owner', 'admin']);

        // Solo el propio usuario puede crear su solicitud de ingreso
        allow create: if isOwner(userId);

        // Solo admin/owner puede actualizar el estado (aceptar/rechazar)
        allow update: if isAuthenticated()
                      && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                           in ['owner', 'admin'];

        allow delete: if false;
      }
    }
  }
}

