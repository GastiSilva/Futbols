rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
//  Firestore Security Rules — Futbols PWA
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() &&
             request.auth.uid == uid;
    }

    function isValidStats(stats) {
      return stats is map
        && stats.goals is int && stats.goals >= 0
        && stats.assists is int && stats.assists >= 0
        && stats.matchesPlayed is int && stats.matchesPlayed >= 0;
    }

    function isOG() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'og';
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
            in ['owner', 'admin'];
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MEMBERS GLOBAL READ
    // ─────────────────────────────────────────────────────────────────────────
    match /{path=**}/members/{userId} {
      allow read: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {

      allow read: if isAuthenticated();

      allow create: if isOwner(userId);

      allow update: if (

        // Usuario actualiza su perfil (fcmToken, displayName, etc - menos stats)
        (
          isOwner(userId)
          && !('stats' in request.resource.data.diff(resource.data).affectedKeys())
        )

        ||

        // Usuario puede actualizar solo su fcmToken y updatedAt
        (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['fcmToken', 'updatedAt'])
        )

        ||

        // Admin cambia role
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'updatedAt'])
        )

        ||

        // SOLO admins u OG modifican stats
        (
          (isAdmin() || isOG())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stats', 'updatedAt'])
        )
      );

      allow delete: if false;

      // ── users/{userId}/groups ─────────────────────────────────────────────
      match /groups/{groupId} {

        allow read: if isOwner(userId);

        allow write: if isOwner(userId)
                     || isGroupAdmin(groupId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MATCHES
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {

      allow read: if isAuthenticated();

      // Solo admins crean partidos
      allow create: if isAdmin();

      // ── UPDATE MATCH ──────────────────────────────────────────────────────
      allow update: if

        // Admin puede todo
        isAdmin()

        ||

        // Usuarios solo pueden modificar currentPlayers
        (
          isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['currentPlayers', 'updatedAt'])
        )

        ||

        // SOLO admins y OG pueden cargar resultados
        (
          (isAdmin() || isOG())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['scoreA', 'scoreB', 'status', 'updatedAt'])
        );

      allow delete: if isAdmin();

      // ──────────────────────────────────────────────────────────────────────
      // REGISTRATIONS
      // ──────────────────────────────────────────────────────────────────────
      match /registrations/{userId} {

        allow read: if isAuthenticated();

        // Usuario se anota a sí mismo
        allow create: if
          isOwner(userId)

          && request.resource.data.userId == request.auth.uid

          // Partido abierto por tiempo
          && (
            request.time >=
            get(/databases/$(database)/documents/matches/$(matchId)).data.openAt

            ||

            // OG entra 30 mins antes
            (
              isOG()
              &&
              request.time >=
              get(/databases/$(database)/documents/matches/$(matchId)).data.openAt
              - duration.value(30, 'm')
            )
          );

        // Admin o dueño modifica inscripción
        allow update: if isAdmin() || isOwner(userId);

        // Cancelar inscripción
        allow delete: if isOwner(userId) || isAdmin();
      }

      // ──────────────────────────────────────────────────────────────────────
      // PLAYER STATS
      // ──────────────────────────────────────────────────────────────────────
      match /playerStats/{userId} {

        allow read: if isAuthenticated();

        // SOLO admin u OG pueden cargar stats
        allow write: if isAdmin() || isOG();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated() && (

        // owner/admin del grupo
        isGroupAdmin(groupId)

        ||

        // usuarios solo actualizan memberCount
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberCount', 'updatedAt'])
      );

      allow delete: if isAuthenticated()
                    && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                         == 'owner';

      // ──────────────────────────────────────────────────────────────────────
      // MEMBERS
      // ──────────────────────────────────────────────────────────────────────
      match /members/{userId} {

        allow read: if isAuthenticated();

        allow create: if
          isOwner(userId)
          || isGroupAdmin(groupId);

        allow update: if isGroupAdmin(groupId);

        allow delete: if
          isOwner(userId)
          || isGroupAdmin(groupId);
      }

      // ──────────────────────────────────────────────────────────────────────
      // JOIN REQUESTS
      // ──────────────────────────────────────────────────────────────────────
      match /joinRequests/{userId} {

        allow read: if
          isOwner(userId)
          || isGroupAdmin(groupId);

        allow create: if isOwner(userId);

        allow update: if isGroupAdmin(groupId);

        allow delete: if false;
      }
    }
  }
}