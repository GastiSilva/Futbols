rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
//  Firestore Security Rules — Futbols PWA
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() &&
             request.auth.uid == uid;
    }

    function isValidStats(stats) {
      return stats is map
        && stats.goals is int && stats.goals >= 0
        && stats.assists is int && stats.assists >= 0
        && stats.matchesPlayed is int && stats.matchesPlayed >= 0;
    }

    // Acceso anticipado por grupo: un miembro tiene acceso anticipado (30 min
    // antes de openAt) si es OG (flag og == true) O si es owner/admin del grupo.
    function memberHasEarlyAccess(groupId, uid) {
      return groupId != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid))
        && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.get('og', false) == true
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.get('role', '') in ['owner', 'admin']
        );
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // ¿El caller tiene acceso anticipado en el grupo del partido?
    function hasEarlyAccessInMatchGroup(matchId) {
      return isAuthenticated()
        && memberHasEarlyAccess(matchData(matchId).get('groupId', null), request.auth.uid);
    }

    // ¿El caller es quien creó el partido? (se puede anotar desde el momento cero)
    function isMatchCreator(matchId) {
      return isAuthenticated()
        && matchData(matchId).get('createdBy', '') == request.auth.uid;
    }

    // Membresía de grupo: el usuario pertenece al grupo.
    function isMemberOfGroup(groupId) {
      return isAuthenticated()
        && groupId != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isMemberOfMatchGroup(matchId) {
      return isMemberOfGroup(
        get(/databases/$(database)/documents/matches/$(matchId)).data.get('groupId', null)
      );
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
            in ['owner', 'admin'];
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MEMBERS GLOBAL READ
    // ─────────────────────────────────────────────────────────────────────────
    match /{path=**}/members/{userId} {
      allow read: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {

      allow read: if isAuthenticated();

      allow create: if isOwner(userId);

      allow update: if (

        // Usuario actualiza su perfil (fcmToken, displayName, apodo, descripción,
        // pie hábil, etc.) — pero nunca stats/statsByGroup (acumulador de la CF)
        // ni su propio role
        (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['stats', 'statsByGroup', 'role'])
        )

        ||

        // Usuario puede actualizar solo su fcmToken y updatedAt
        (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['fcmToken', 'updatedAt'])
        )

        ||

        // Admin cambia role
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'updatedAt'])
        )

        ||

        // Stats (total y por grupo): el acumulador lo escribe la Cloud Function
        // onPlayerStatsWritten (admin SDK, ignora estas reglas). Desde el cliente
        // solo un admin global puede tocarlas manualmente.
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stats', 'statsByGroup', 'updatedAt'])
        )
      );

      allow delete: if false;

      // ── users/{userId}/groups ─────────────────────────────────────────────
      match /groups/{groupId} {

        allow read: if isOwner(userId);

        allow write: if isOwner(userId)
                     || isGroupAdmin(groupId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MATCHES
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {

      allow read: if isAuthenticated();

      // Crean partidos: admins globales, o el owner/admin del grupo del partido
      allow create: if
        isAdmin()
        || (
          request.resource.data.createdBy == request.auth.uid
          && request.resource.data.groupId != null
          && isGroupAdmin(request.resource.data.groupId)
        );

      // ── UPDATE MATCH ──────────────────────────────────────────────────────
      allow update: if

        // Admin puede todo
        isAdmin()

        ||

        // Usuarios solo pueden modificar currentPlayers
        (
          isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['currentPlayers', 'updatedAt'])
        )

        ||

        // Cargar el resultado (incluye MVP): cualquier miembro del grupo (o admin)
        (
          (isAdmin() || isMemberOfMatchGroup(matchId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['scoreA', 'scoreB', 'status', 'mvpUserId', 'mvpName', 'updatedAt'])
        );

      allow delete: if isAdmin();

      // ──────────────────────────────────────────────────────────────────────
      // REGISTRATIONS
      // ──────────────────────────────────────────────────────────────────────
      match /registrations/{userId} {

        allow read: if isAuthenticated();

        // ── ALTA ──────────────────────────────────────────────────────────
        // Tres ventanas posibles:
        //  (0) El creador del partido se anota A SÍ MISMO en cualquier momento.
        //  (1) Ventana abierta (request.time >= openAt): uno mismo, invitado
        //      sin cuenta, u otro miembro existente.
        //  (2) Ventana anticipada (openAt - 30 min): solo si el anotador tiene
        //      acceso anticipado (OG / owner / admin del grupo) o es el creador,
        //      y SOLO puede anotarse a sí mismo o a otro miembro que TAMBIÉN
        //      tenga acceso anticipado. Invitados no.
        allow create: if
          isAuthenticated()
          && (
            // (0) creador del partido → él mismo, sin restricción de horario
            (
              isOwner(userId)
              && request.resource.data.userId == request.auth.uid
              && isMatchCreator(matchId)
            )

            ||

            // (1) ventana abierta para todos
            (
              request.time >= matchData(matchId).openAt
              && (
                // (a) me anoto yo mismo (docId = mi uid)
                (
                  isOwner(userId)
                  && request.resource.data.userId == request.auth.uid
                )

                ||

                // (b) anoto a un invitado sin cuenta (docId autogenerado)
                (
                  request.resource.data.isGuest == true
                  && request.resource.data.addedBy == request.auth.uid
                )

                ||

                // (c) anoto a otro miembro existente (docId = uid del anotado)
                (
                  request.resource.data.isGuest == false
                  && request.resource.data.userId == userId
                  && request.resource.data.addedBy == request.auth.uid
                )
              )
            )

            ||

            // (2) ventana anticipada (30 min antes de openAt)
            (
              request.time >= matchData(matchId).openAt - duration.value(30, 'm')
              && (hasEarlyAccessInMatchGroup(matchId) || isMatchCreator(matchId))
              && (
                // me anoto yo mismo
                (
                  isOwner(userId)
                  && request.resource.data.userId == request.auth.uid
                  && hasEarlyAccessInMatchGroup(matchId)
                )

                ||

                // anoto a otro miembro que también tiene acceso anticipado
                (
                  request.resource.data.isGuest == false
                  && request.resource.data.userId == userId
                  && request.resource.data.addedBy == request.auth.uid
                  && memberHasEarlyAccess(matchData(matchId).get('groupId', null), userId)
                )
              )
            )
          );

        // Admin o dueño modifica inscripción
        allow update: if isAdmin() || isOwner(userId);

        // Cancelar inscripción: uno mismo, admin, o quien lo anotó (invitado/miembro)
        allow delete: if
          isOwner(userId)
          || isAdmin()
          || resource.data.get('addedBy', '') == request.auth.uid;
      }

      // ──────────────────────────────────────────────────────────────────────
      // PLAYER STATS
      // ──────────────────────────────────────────────────────────────────────
      match /playerStats/{userId} {

        allow read: if isAuthenticated();

        // Cargar stats individuales: cualquier miembro del grupo del partido (o admin).
        // El acumulador en users/{uid} lo escribe la Cloud Function onPlayerStatsWritten
        // (admin SDK), no el cliente.
        allow write: if isAdmin() || isMemberOfMatchGroup(matchId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated() && (

        // owner/admin del grupo
        isGroupAdmin(groupId)

        ||

        // usuarios solo actualizan memberCount
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberCount', 'updatedAt'])
      );

      allow delete: if isAuthenticated()
                    && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                         == 'owner';

      // ──────────────────────────────────────────────────────────────────────
      // MEMBERS
      // ──────────────────────────────────────────────────────────────────────
      match /members/{userId} {

        allow read: if isAuthenticated();

        allow create: if
          isOwner(userId)
          || isGroupAdmin(groupId);

        allow update: if isGroupAdmin(groupId);

        allow delete: if
          isOwner(userId)
          || isGroupAdmin(groupId);
      }

      // ──────────────────────────────────────────────────────────────────────
      // JOIN REQUESTS
      // ──────────────────────────────────────────────────────────────────────
      match /joinRequests/{userId} {

        allow read: if
          isOwner(userId)
          || isGroupAdmin(groupId);

        allow create: if isOwner(userId);

        allow update: if isGroupAdmin(groupId);

        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // VENUES (sedes / canchas)
    // ─────────────────────────────────────────────────────────────────────────
    match /venues/{venueId} {

      allow read: if isAuthenticated();

      // Cualquier usuario autenticado puede crear una sede (firmándola)
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;

      // Editar: cualquier usuario autenticado.
      // Idealmente sería "solo OGs", pero el rol OG es POR-GRUPO (members.og) y
      // las sedes son globales: las reglas no pueden verificar "es OG en algún
      // grupo" sin un groupId (no se puede iterar la colección de grupos). El
      // gating real de "solo OGs" vive en la UI (canEditVenue). Como las sedes
      // son datos de bajo riesgo y quedan denormalizados en cada partido, se
      // acepta permitir la edición a cualquier autenticado a nivel de reglas.
      allow update: if isAuthenticated();

      // Borrar (destructivo): solo quien la creó o un admin global.
      allow delete: if isAdmin()
                    || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }
  }
}