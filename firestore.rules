rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
//  Firestore Security Rules — Futbols PWA
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Usuario con CUENTA real (Google o email/password). Los invitados
    // anónimos (link de partido compartido) quedan deliberadamente afuera:
    // isAuthenticated() es la base de casi todos los permisos de escritura de
    // la app —crear partidos, sedes, grupos, perfil, votar MVP— y nada de eso
    // les corresponde. Lo único que pueden hacer tiene su propia rama
    // explícita: leer un partido y anotarse como invitado (ver isAnonGuest).
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Invitado anónimo: entró por un link de partido compartido y todavía no
    // creó una cuenta. Solo puede leer el partido/su lista y anotarse.
    function isAnonGuest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() &&
             request.auth.uid == uid;
    }

    function isValidStats(stats) {
      return stats is map
        && stats.goals is int && stats.goals >= 0
        && stats.assists is int && stats.assists >= 0
        && stats.matchesPlayed is int && stats.matchesPlayed >= 0;
    }

    // Acceso anticipado por grupo: un miembro tiene acceso anticipado (30 min
    // antes de openAt) si es OG (flag og == true) O si es owner/admin del grupo.
    function memberHasEarlyAccess(groupId, uid) {
      return groupId != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid))
        && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.get('og', false) == true
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.get('role', '') in ['owner', 'admin']
        );
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    // ¿El invitado anónimo tiene (o está creando) una inscripción en ESTE
    // partido? Es lo que lo ata al partido de su link: sin esto, cualquier
    // sesión anónima podía tocar el contador de cupos de cualquier partido.
    // Se mira el estado FUTURO además del actual porque el alta crea el doc de
    // inscripción y mueve currentPlayers en la misma transacción.
    function guestHasEntryInMatch(matchId) {
      return existsAfter(/databases/$(database)/documents/matches/$(matchId)/registrations/$(request.auth.uid))
        || exists(/databases/$(database)/documents/matches/$(matchId)/registrations/$(request.auth.uid));
    }

    // ¿El caller tiene acceso anticipado en el grupo del partido?
    function hasEarlyAccessInMatchGroup(matchId) {
      return isAuthenticated()
        && memberHasEarlyAccess(matchData(matchId).get('groupId', null), request.auth.uid);
    }

    // ¿El caller es quien creó el partido? (se puede anotar desde el momento cero)
    function isMatchCreator(matchId) {
      return isAuthenticated()
        && matchData(matchId).get('createdBy', '') == request.auth.uid;
    }

    // Membresía de grupo: el uid dado pertenece al grupo.
    function isMemberOfGroup(groupId, uid) {
      return groupId != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }

    function isMemberOfMatchGroup(matchId) {
      return isAuthenticated()
        && isMemberOfGroup(
             get(/databases/$(database)/documents/matches/$(matchId)).data.get('groupId', null),
             request.auth.uid
           );
    }

    // Validación del payload de una fila de playerStats. El `userId` del doc
    // tiene que coincidir con el docId (no se cargan stats "a nombre de otro"
    // pisando el uid real), los contadores son enteros >= 0 y el equipo es A,
    // B o ninguno.
    //
    // ⚠️ `team` se lee con get() y no como `request.resource.data.team`: un
    // jugador sin equipo asignado NO trae el campo (Firestore descarta los
    // `undefined` al escribir), y comparar un campo AUSENTE contra la lista
    // daba falso. Ese era el PERMISSION_DENIED que solo sufrían los miembros
    // comunes — el admin global se colaba por la rama `|| isAdmin()`.
    function statsPayloadIsValid(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.goals is int && request.resource.data.goals >= 0
        && request.resource.data.assists is int && request.resource.data.assists >= 0
        && request.resource.data.get('team', null) in ['A', 'B', null];
    }

    // Un partido sin grupo (groupId null) es global: lo crea un admin y queda
    // abierto a cualquier usuario autenticado.
    function isGroupless(matchId) {
      return matchData(matchId).get('groupId', null) == null;
    }

    // ¿El caller comparte el grupo `groupId` con `otherUid`? Ambos tienen que
    // ser miembros. Se usa para habilitar acciones que solo tienen sentido
    // entre gente que se conoce (ej. calificar si la descripción de alguien es
    // real): un desconocido no tiene forma de saberlo, y dejarlo calificar
    // convierte la calificación en un arma contra quien se postula de afuera.
    function sharesGroupWith(groupId, otherUid) {
      return isMemberOfGroup(groupId, request.auth.uid)
        && isMemberOfGroup(groupId, otherUid);
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
            in ['owner', 'admin'];
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MEMBERS GLOBAL READ
    // ─────────────────────────────────────────────────────────────────────────
    match /{path=**}/members/{userId} {
      allow read: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // APPLICATIONS GLOBAL LIST (collectionGroup)
    // ─────────────────────────────────────────────────────────────────────────
    // ⚠️ Comprobado empíricamente (no es una lectura de la doc): una regla
    // `allow list` anidada dentro de `match /matches/{matchId} { match
    // /applications/{id} {...} }` NO habilita queries `collectionGroup()`,
    // sin importar la condición — Firestore responde "No matching allow
    // statements" aunque la condición sea `if true`. Para que "mis
    // postulaciones" (subscribeToMyApplications, un collectionGroup filtrado
    // por applicantId) funcione, hace falta esta regla en el nivel superior
    // del árbol, con el mismo patrón recursivo que ya usa members arriba.
    // El `allow list` de la subcolección anidada (más abajo) sigue cubriendo
    // las queries normales de un partido puntual (organizador viendo "se
    // quieren sumar"); esta es la que faltaba para el caso collectionGroup.
    match /{path=**}/applications/{applicantId} {
      allow list: if isAuthenticated() && request.query.limit <= 50;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {

      allow read: if isAuthenticated();

      allow create: if isOwner(userId);

      allow update: if (

        // Usuario actualiza su perfil (fcmToken, displayName, apodo, descripción,
        // pie hábil, etc.) — pero nunca stats/statsByGroup (acumulador de la CF),
        // su propio role, ni mundial (tiene su propia cláusula de activación abajo)
        (
          isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['stats', 'statsByGroup', 'role', 'mundial'])
        )

        ||

        // Usuario puede actualizar solo su fcmToken y updatedAt
        (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['fcmToken', 'updatedAt'])
        )

        ||

        // Admin cambia role
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'updatedAt'])
        )

        ||

        // Stats (total y por grupo): el acumulador lo escribe la Cloud Function
        // onPlayerStatsWritten (admin SDK, ignora estas reglas). Desde el cliente
        // solo un admin global puede tocarlas manualmente. `mundial` incluido acá
        // también como vía de escape manual para soporte (resetear un Mundial
        // trabado) sin necesitar una Cloud Function dedicada.
        (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stats', 'statsByGroup', 'mundial', 'updatedAt'])
        )

        ||

        // Mundial personal: el dueño solo puede ACTIVAR uno nuevo (nunca tenía
        // uno en curso), y solo al estado inicial exacto de la fase de grupos.
        // Todo avance de fase, coin flip, título o eliminación lo escribe
        // exclusivamente la Cloud Function (admin SDK) vía advancePlayerMundial /
        // revealMundialCoinFlip.
        (
          isOwner(userId)
          && resource.data.get('mundial', {}).get('active', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mundial', 'updatedAt'])
          && request.resource.data.mundial.active == true
          && request.resource.data.mundial.phase == 'groups'
          && request.resource.data.mundial.groupMatchResults == []
          && request.resource.data.mundial.pendingCoinFlip == null
        )
      );

      allow delete: if false;

      // ── users/{userId}/groups ─────────────────────────────────────────────
      match /groups/{groupId} {

        allow read: if isOwner(userId);

        allow write: if isOwner(userId)
                     || isGroupAdmin(groupId);
      }

      // ── users/{userId}/badges ──────────────────────────────────────────────
      // Insignias mensuales ganadas (Botín de Oro, Manos de Seda, Figura del
      // Mes). Son un premio PÚBLICO: se leen sin restricción, que es
      // justamente la gracia — el que se postula desde afuera muestra lo que
      // ganó. Lo que ProfileViewPage sí oculta a un desconocido es el NOMBRE
      // del grupo (ver describeBadge en src/utils/badges.js), por el mismo
      // motivo por el que se oculta statsByGroup: expone el mapa social.
      //
      // NADIE las escribe desde el cliente, ni siquiera el dueño del perfil ni
      // un admin global: las otorga solo la tarea runMonthlyBadges por admin
      // SDK, que se saltea estas reglas. Si el cliente pudiera escribir acá,
      // cualquiera se autoproclamaría goleador del mes.
      match /badges/{badgeId} {
        allow read: if true;
        allow write: if false;
      }

      // ── users/{userId}/descriptionRatings ───────────────────────────────────
      // Estrellas (1-5) que otros usuarios asignan en privado a la descripción
      // de este perfil. Un doc por calificador (docId = su propio uid), así se
      // puede actualizar su voto. Solo el calificador puede leer SU PROPIO voto
      // (ni el dueño del perfil ni otros calificadores lo ven) — el promedio lo
      // calcula la Cloud Function onDescriptionRatingWritten (admin SDK) y lo
      // publica en users/{userId}/private/descriptionStars.
      match /descriptionRatings/{raterId} {

        allow read: if isOwner(raterId) || isAdmin();

        // Solo puede calificar quien COMPARTE UN GRUPO con el dueño del perfil.
        // Antes alcanzaba con estar autenticado: cualquiera podía calificar a
        // cualquiera. Con los partidos públicos eso pasa de ser una imprecisión
        // a un vector de sabotaje — un desconocido no tiene cómo saber si la
        // descripción de alguien es real, y su voto solo sirve para hundirle el
        // promedio a quien se postuló a su partido.
        //
        // El grupo compartido viaja en `sharedGroupId` porque las reglas no
        // pueden recorrer los grupos del usuario: no hay forma de iterar una
        // colección desde acá, solo de verificar documentos puntuales. El
        // cliente declara por cuál grupo se conocen y la regla comprueba que
        // AMBOS sean miembros de ese grupo — si miente, la verificación falla.
        allow create, update: if
          isOwner(raterId)
          && raterId != userId
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1
          && request.resource.data.stars <= 5
          && request.resource.data.sharedGroupId is string
          && sharesGroupWith(request.resource.data.sharedGroupId, userId);

        allow delete: if isAdmin();
      }

      // ── users/{userId}/chemistry ─────────────────────────────────────────────
      // Historial de resultados jugando en el MISMO equipo que otro jugador
      // (gamesTogether/winsTogether/...). A diferencia de descriptionRatings,
      // acá se opta por lectura abierta a cualquier autenticado (no privado):
      // no es un dato sensible tipo calificación personal, es un agregado
      // objetivo como `stats`, y el balanceador de equipos (client-side, ver
      // useTeamBalancer.js) necesita leer la química de TODOS los jugadores
      // del partido, no solo la propia. Solo la Cloud Function
      // onPlayerStatsWritten (y su backfill recalcAllStats) la escribe.
      match /chemistry/{otherUid} {

        allow read: if isAuthenticated();

        allow write: if false;
      }

      // ── users/{userId}/private ──────────────────────────────────────────────
      // Datos derivados que solo el dueño del perfil puede ver (ej. el promedio
      // de estrellas de su descripción). Doc separado del users/{userId}
      // principal porque las reglas de Firestore no pueden ocultar campos
      // sueltos dentro de un mismo documento — y ese doc ya es legible por
      // cualquier autenticado (ver perfil de un compañero de grupo).
      match /private/{docId} {

        allow read: if isOwner(userId) || isAdmin();

        // Solo lo escribe la Cloud Function (admin SDK, ignora estas reglas).
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MATCHES
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {

      // Leer un partido: un admin global, o alguien del grupo que lo organiza.
      // Los partidos sin grupo (groupId null) son globales y los ve cualquier
      // usuario con cuenta. Antes esto era `isAuthenticated()` a secas: CUALQUIER
      // usuario logueado podía leer los partidos de TODOS los grupos, incluidos
      // aquellos a los que no pertenece.
      //
      // Los invitados anónimos leen SOLO el partido del link que les compartieron
      // (matchId == su guestMatchId, que el cliente fija al entrar). Como las
      // reglas no ven el sessionStorage del cliente, se valida distinto: el
      // invitado solo puede leer un partido puntual por id — nunca listarlos.
      // Rama extra: un partido PUBLICADO (isPublic == true) lo puede leer
      // cualquier usuario con cuenta, aunque no sea del grupo — es lo que
      // habilita a alguien de afuera a verlo antes de postularse
      // (matches/applications). No abre `registrations`: eso sigue exigiendo
      // membresía de grupo, así que el que se postula ve el partido pero no
      // la lista de anotados hasta que lo acepten.
      // Rama extra: quien ya tiene una registration propia ahí (le aceptaron
      // una postulación) sigue viendo el partido aunque el organizador lo
      // despublique después — sin esto, "despublicar" le tapaba el partido a
      // alguien que ya estaba anotado, no solo a los que faltaban postularse.
      allow get: if
        isAdmin()
        || isAnonGuest()
        || (isAuthenticated() && (isGroupless(matchId) || isMemberOfMatchGroup(matchId)))
        || (isAuthenticated() && matchData(matchId).get('isPublic', false) == true)
        || (isAuthenticated() && guestHasEntryInMatch(matchId));

      // Listar/consultar partidos (query). Un invitado anónimo nunca lista: lee
      // su partido puntual por id (allow get de arriba).
      //
      // ⚠️ LIMITACIÓN REAL DE FIRESTORE, no una decisión de diseño: las reglas
      // NO pueden inspeccionar las cláusulas `where` de una query. `request.query`
      // expone únicamente `limit`, `offset` y `orderBy`. Y como el motor evalúa
      // las queries sin leer documentos, tampoco hay `resource` que consultar.
      // El mecanismo previsto por Firestore para esto es escribir la condición
      // como si fuera de documento y dejar que el motor rechace la query salvo
      // que sus filtros garanticen que TODO resultado la cumple — pero esa
      // demostración no puede depender de un `get()` a otra colección, y la
      // membresía vive en groups/{gid}/members/{uid}. O sea: "solo los partidos
      // de mis grupos" es INEXPRESABLE en un allow list.
      //
      // Por eso el aislamiento por grupo se sostiene en `allow get` (que sí lee
      // el documento y verifica membresía) y en que la query del cliente pida
      // solo lo suyo (useMatch.subscribeToUpcoming, que ahora filtra por groupId
      // en la consulta y ya no se descarga los partidos de todos los grupos).
      //
      // Lo que SÍ se endurece acá es el `limit`: sin tope, una sola query podía
      // barrer la colección entera de una. Con tope, enumerarla cuesta muchas
      // consultas y deja rastro. Es mitigación, no aislamiento — el aislamiento
      // de verdad para los datos sensibles del partido está en `allow get` y en
      // las reglas de `registrations`.
      allow list: if
        isAdmin()
        || (isAuthenticated() && request.query.limit <= 200);

      // Crean partidos: admins globales, o CUALQUIER miembro del grupo del
      // partido (no hace falta ser owner/admin del grupo para armar una lista).
      allow create: if
        isAdmin()
        || (
          request.resource.data.createdBy == request.auth.uid
          && request.resource.data.groupId != null
          && isMemberOfGroup(request.resource.data.groupId, request.auth.uid)
        );

      // ── UPDATE MATCH ──────────────────────────────────────────────────────
      allow update: if

        // Admin puede todo
        isAdmin()

        ||

        // Usuarios solo pueden modificar currentPlayers: deben ser miembros
        // del grupo del partido (o admin/partido sin grupo), el valor debe
        // ser un entero >= 0, y solo puede moverse de a UNO por vez (+1 al
        // anotarse, -1 al bajarse) — nunca un salto arbitrario. El caso
        // "== mismo valor" solo se permite cuando ya estaba en 0 (clamp de
        // useRegistration.removeRegistration al bajarse con el contador ya
        // en cero, un borde de estado inconsistente que no debe bloquearse).
        // isAnonGuest incluido porque la transacción de inscripción/baja de un
        // invitado del link también mueve este contador — con las mismas
        // restricciones que todos: ±1, entero >= 0, y nada más que este campo.
        // Un invitado anónimo solo mueve el contador del partido en el que
        // TIENE una inscripción propia (la que acaba de crear, o la que está
        // por borrar). Antes bastaba con ser anónimo: podía sumar o restar
        // cupos en partidos de cualquier grupo, sin pertenecer a ninguno.
        (
          (
            isAdmin()
            || isGroupless(matchId)
            || isMemberOfMatchGroup(matchId)
            || (isAnonGuest() && guestHasEntryInMatch(matchId))
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['currentPlayers', 'updatedAt'])
          && request.resource.data.currentPlayers is int
          && request.resource.data.currentPlayers >= 0
          && (
            request.resource.data.currentPlayers == resource.data.currentPlayers + 1
            || request.resource.data.currentPlayers == resource.data.currentPlayers - 1
            || (resource.data.currentPlayers == 0 && request.resource.data.currentPlayers == 0)
          )
        )

        ||

        // Mismo alta de arriba, pero cuando ese +1 llena el último cupo de un
        // partido publicado: se despublica en la misma escritura (cierra la
        // postulación pública apenas se llena, sin depender de ningún job).
        // Solo puede APAGAR isPublic (nunca prenderlo) y solo junto con el
        // +1 correcto — no abre una vía nueva para despublicar por las suyas.
        (
          (
            isAdmin()
            || isGroupless(matchId)
            || isMemberOfMatchGroup(matchId)
            || (isAnonGuest() && guestHasEntryInMatch(matchId))
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['currentPlayers', 'updatedAt', 'isPublic'])
          && request.resource.data.currentPlayers is int
          && request.resource.data.currentPlayers == resource.data.currentPlayers + 1
          && resource.data.get('isPublic', false) == true
          && request.resource.data.isPublic == false
          && request.resource.data.get('maxPlayers', null) != null
          && request.resource.data.currentPlayers >= request.resource.data.maxPlayers
        )

        ||

        // Editar datos generales del partido (título, sede, fecha, horarios,
        // formato): quien tiene acceso anticipado en el grupo (OG/owner/
        // admin) o quien creó el partido — antes esto solo lo podía hacer un
        // admin global desde el panel de admin. groupId no se puede
        // reasignar desde acá (mover un partido a otro grupo queda para un
        // admin global, vía la rama de arriba).
        (
          (hasEarlyAccessInMatchGroup(matchId) || isMatchCreator(matchId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'title', 'location', 'venueId', 'venueMapsUrl', 'venueLat', 'venueLng',
                 // Denormalizados de la sede (derivados del geocoding) — habilitan
                 // el filtro por provincia en "Partidos abiertos". Van en esta
                 // lista porque updateMatch los reescribe al editar el partido:
                 // sin ellos, editar cualquier partido daría permission-denied.
                 'provincia', 'ciudad',
                 'date', 'openAt', 'notifyAt', 'format', 'maxPlayers', 'status', 'updatedAt',
                 // Publicación del partido al resto de la app ("busco jugadores").
                 // Mismo permiso que editar los datos: quien gestiona el partido.
                 'isPublic', 'publishedAt', 'spotsWanted'
               ])
          && request.resource.data.groupId == resource.data.groupId
        )

        ||

        // Cargar el resultado: CUALQUIER miembro del grupo (o admin), apenas
        // termina el partido y sin límite de tiempo. Antes se exigía además
        // `resultLocked == false` (lo fija el auto-cierre a las 36hs), lo que
        // dejaba al grupo sin poder cargar su propio resultado si tardaban un
        // par de días — y como la rama `isAdmin()` no pasaba por esa condición,
        // el dueño de la app podía cargar siempre y nadie más. El MVP ya NO se
        // escribe acá — lo decide la votación (mvpVotes) y lo fija la Cloud
        // Function closeMvpVoting (Admin SDK, ignora estas reglas).
        // scoreA/scoreB deben ser enteros >= 0 y status un valor válido.
        (
          (isAdmin() || isMemberOfMatchGroup(matchId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['scoreA', 'scoreB', 'status', 'finishedAt', 'updatedAt'])
          && request.resource.data.scoreA is int && request.resource.data.scoreA >= 0
          && request.resource.data.scoreB is int && request.resource.data.scoreB >= 0
          // Cargar un resultado SOLO puede dejar el partido en 'finished'. Antes
          // se aceptaba cualquiera de los cuatro estados, así que un miembro
          // común podía mandar `status: 'closed'` por esta rama y cerrarle la
          // lista a todo el grupo en pleno horario de inscripción.
          && request.resource.data.status == 'finished'
        )

        ||

        // Marcar/desmarcar "cancha reservada": cualquier miembro del grupo
        // (o admin) — mismo criterio que cargar resultado, sin exigir que el
        // partido haya terminado (se reserva ANTES de jugar).
        (
          (isAdmin() || isMemberOfMatchGroup(matchId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['venueReserved', 'updatedAt'])
        );

      // Borrar un partido: admin global, quien lo creó, o quien tiene acceso
      // anticipado en el grupo (OG/owner/admin). Cubre el caso de "saqué la
      // lista dos veces sin querer" o "no se anotó nadie" — el mismo criterio
      // que ya rige para editar los datos del partido.
      allow delete: if
        isAdmin()
        || isMatchCreator(matchId)
        || hasEarlyAccessInMatchGroup(matchId);

      // ──────────────────────────────────────────────────────────────────────
      // REGISTRATIONS
      // ──────────────────────────────────────────────────────────────────────
      match /registrations/{userId} {

        // Ver quién está anotado: gente del grupo del partido (o admin, o
        // partido global). Antes cualquier autenticado leía las listas de
        // todos los grupos.
        //
        // ⚠️ `get` y `list` van SEPARADOS, y el invitado anónimo NO puede
        // condicionarse a "tener ya una inscripción". Dos motivos:
        //
        //  (1) Dependencia circular en el alta. `registerEntry` abre la
        //      transacción leyendo su propio doc de inscripción para detectar
        //      si ya se anotó (matches/{id}/registrations/{su-uid}). Ese doc
        //      todavía NO existe, así que una condición tipo
        //      guestHasEntryInMatch() lo rechaza: no lo dejan leer porque no
        //      está anotado, y no se puede anotar porque no lo dejan leer.
        //      Ese era el 403 (PERMISSION_DENIED en :batchGet) al apretar
        //      "Anotarme". `existsAfter` tampoco lo salva: en la fase de
        //      LECTURA de la transacción no hay estado futuro que mirar.
        //
        //  (2) Una condición que dependa de un documento puntual es
        //      incompatible con `list`: Firestore evalúa las reglas de query
        //      SIN leer los docs, así que la query entera (el onSnapshot con
        //      orderBy('position') de subscribeToRegistrations) se rechaza
        //      aunque el invitado ya estuviera anotado.
        //
        // Lo que ata al invitado a SU partido no se pierde: sigue vigente
        // donde importa — mover el contador de cupos (guestHasEntryInMatch en
        // el update de matches) y crear/borrar su propia inscripción. Leer la
        // lista de un partido cuyo id no conoce no es un riesgo real: para
        // llegar acá necesita el matchId exacto, que es justamente el link que
        // le compartieron.
        // Rama extra: quien llegó por una postulación pública aceptada tiene
        // una registration propia en ESTE partido sin ser miembro del grupo —
        // sin esto, ver el detalle del partido (MatchDetailPage) le tiraba
        // permission-denied al cargar la lista de anotados, aunque él mismo
        // ya estuviera en ella.
        allow get: if
          isAdmin()
          || isAnonGuest()
          || (isAuthenticated() && (isGroupless(matchId) || isMemberOfMatchGroup(matchId)))
          || (isAuthenticated() && guestHasEntryInMatch(matchId));

        allow list: if
          isAdmin()
          || isAnonGuest()
          || (isAuthenticated() && (isGroupless(matchId) || isMemberOfMatchGroup(matchId)))
          || (isAuthenticated() && guestHasEntryInMatch(matchId));

        // ── ALTA ──────────────────────────────────────────────────────────
        // Tres ventanas posibles:
        //  (0) El creador del partido se anota A SÍ MISMO en cualquier momento.
        //  (1) Ventana abierta (request.time >= openAt): uno mismo, invitado
        //      sin cuenta, u otro miembro existente.
        //  (2) Ventana anticipada (openAt - 30 min): solo si el anotador tiene
        //      acceso anticipado (OG / owner / admin del grupo) o es el creador,
        //      y SOLO puede anotarse a sí mismo o a otro miembro que TAMBIÉN
        //      tenga acceso anticipado. Invitados no.
        allow create: if
          (isAuthenticated() || isAnonGuest())
          && (
            // (0) creador del partido → él mismo, sin restricción de horario
            (
              isOwner(userId)
              && request.resource.data.userId == request.auth.uid
              && isMatchCreator(matchId)
            )

            ||

            // (0b) INVITADO ANÓNIMO (link de partido compartido): tiene sesión
            // de Firebase pero sin cuenta (provider anónimo), así que no es
            // miembro de ningún grupo y ninguna otra rama lo dejaría entrar.
            // Se anota como invitado (isGuest, userId null) — no acumula
            // estadísticas — y SOLO a partir de openAt: nunca en la ventana
            // anticipada, igual que cualquier otro invitado.
            //
            // `isOwner(userId)` NO sirve acá (excluye anónimos): se compara el
            // docId contra el uid a mano. Que el docId sea su propio uid es lo
            // que ata al invitado a UNA inscripción por partido y permite que
            // el resto de las reglas verifiquen que el contador de cupos que
            // mueve es el de SU partido (guestHasEntryInMatch).
            (
              isAnonGuest()
              && userId == request.auth.uid
              && request.time >= matchData(matchId).openAt
              && request.resource.data.isGuest == true
              && request.resource.data.userId == null
              && request.resource.data.addedBy == request.auth.uid
            )

            ||

            // (1) ventana abierta para todos — pero solo para miembros del
            // grupo del partido (o admin global, o partido sin grupo/global)
            (
              request.time >= matchData(matchId).openAt
              && (isGroupless(matchId) || isMemberOfMatchGroup(matchId))
              && (
                // (a) me anoto yo mismo (docId = mi uid)
                (
                  isOwner(userId)
                  && request.resource.data.userId == request.auth.uid
                )

                ||

                // (b) anoto a un invitado sin cuenta (docId autogenerado)
                (
                  request.resource.data.isGuest == true
                  && request.resource.data.addedBy == request.auth.uid
                )

                ||

                // (c) anoto a otro miembro existente (docId = uid del anotado);
                // ese miembro también debe pertenecer al grupo del partido
                (
                  request.resource.data.isGuest == false
                  && request.resource.data.userId == userId
                  && request.resource.data.addedBy == request.auth.uid
                  && (isGroupless(matchId) || isMemberOfGroup(matchData(matchId).get('groupId', null), userId))
                )
              )
            )

            ||

            // (2) ventana anticipada (30 min antes de openAt). No aplica a los
            // partidos de apertura inmediata (instantOpen): ahí la lista se
            // abrió en el momento y arrancan todos juntos, sin adelanto para
            // los OG — solo queda la rama (1), que exige request.time >= openAt.
            (
              matchData(matchId).get('instantOpen', false) == false
              && request.time >= matchData(matchId).openAt - duration.value(30, 'm')
              && (hasEarlyAccessInMatchGroup(matchId) || isMatchCreator(matchId))
              && (
                // me anoto yo mismo
                (
                  isOwner(userId)
                  && request.resource.data.userId == request.auth.uid
                  && hasEarlyAccessInMatchGroup(matchId)
                )

                ||

                // anoto a otro miembro que también tiene acceso anticipado
                (
                  request.resource.data.isGuest == false
                  && request.resource.data.userId == userId
                  && request.resource.data.addedBy == request.auth.uid
                  && memberHasEarlyAccess(matchData(matchId).get('groupId', null), userId)
                )
              )
            )
          );

        // Admin o dueño modifica inscripción. Además, quien tiene acceso
        // anticipado en el grupo del partido (OG/owner/admin) puede asignar
        // el equipo (A/B) de CUALQUIER inscripto — necesario para armar
        // equipos balanceados antes de jugar (useTeamBalancer) — pero SOLO
        // puede tocar el campo `team`, nada más.
        allow update: if
          isAdmin()
          || isOwner(userId)
          || (
            hasEarlyAccessInMatchGroup(matchId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team'])
          );

        // Cancelar inscripción: uno mismo, admin, o quien lo anotó (invitado/
        // miembro). El invitado anónimo entra por la última condición: su
        // propio uid quedó en `addedBy` al anotarse, así que puede bajarse
        // solo — pero solo de SU inscripción, no de la de otro.
        allow delete: if
          isOwner(userId)
          || isAdmin()
          || resource.data.get('addedBy', '') == request.auth.uid;
      }

      // ──────────────────────────────────────────────────────────────────────
      // APPLICATIONS (postulaciones a un partido público)
      // ──────────────────────────────────────────────────────────────────────
      // Alguien de AFUERA del grupo se ofrece a jugar un partido publicado.
      // Es deliberadamente una colección SEPARADA de `registrations`: una
      // postulación no ocupa cupo ni mueve `currentPlayers` — es una solicitud
      // pendiente. Recién cuando el organizador la acepta, la Cloud Function
      // onApplicationAccepted crea la registration de verdad.
      //
      // Esa separación es lo que permite no tocar en absoluto las reglas de
      // `registrations`: el postulante nunca escribe ahí, ni siquiera al ser
      // aceptado (lo hace la CF con Admin SDK).
      match /applications/{applicantId} {

        // Ver una postulación: el propio postulante (para seguir su estado) o
        // cualquier miembro del grupo del partido (la evalúan entre todos, y
        // el organizador la resuelve).
        allow get: if
          isAdmin()
          || isOwner(applicantId)
          || isMemberOfMatchGroup(matchId);

        // Listar (queries directas de subcolección, ej. "se quieren sumar" en
        // el detalle del partido): los miembros del grupo ven todas las de su
        // partido. El caso "mis postulaciones" (collectionGroup filtrando por
        // applicantId) NO lo cubre esta regla — ver el bloque
        // `{path=**}/applications` más arriba en el archivo.
        allow list: if isAdmin() || isMemberOfMatchGroup(matchId);

        // Postularse: cualquiera con cuenta, SOLO a nombre propio, SOLO si el
        // partido está publicado, y siempre naciendo en 'pending'.
        //
        // `!isMemberOfMatchGroup` es a propósito: si ya sos del grupo te
        // anotás derecho en la lista, no te postulás. Sin esta condición
        // habría dos caminos para lo mismo y el organizador vería
        // postulaciones de gente que ya podía entrar sola.
        allow create: if
          isAuthenticated()
          && isOwner(applicantId)
          && request.resource.data.applicantId == request.auth.uid
          && !isMemberOfMatchGroup(matchId)
          && matchData(matchId).get('isPublic', false) == true
          && request.resource.data.status == 'pending'
          && request.resource.data.get('message', '') is string
          && request.resource.data.get('message', '').size() <= 300;

        // Resolver: solo quien gestiona el partido (mismo criterio que editarlo)
        // puede aceptar o rechazar. El propio postulante solo puede RETIRARSE
        // ('withdrawn'), y solo mientras siga pendiente — una vez resuelta, ni
        // él ni nadie la reabre.
        allow update: if
          isAdmin()
          || (
            (hasEarlyAccessInMatchGroup(matchId) || isMatchCreator(matchId))
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'resolvedAt', 'resolvedBy', 'updatedAt'])
            && request.resource.data.status in ['accepted', 'rejected']
          )
          || (
            isOwner(applicantId)
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'withdrawn'
          );

        // Nunca se borran: quedan como registro, igual que joinRequests.
        allow delete: if false;

        // ── Chat 1-a-1 de la postulación ────────────────────────────────────
        // Conversación privada entre el postulante y quien gestiona el partido,
        // para coordinar lo básico ("¿dónde es?", "llevá algo blanco", "llego
        // 10 min tarde").
        //
        // Es a propósito 1-a-1 y NO un chat grupal del partido: un chat de 14
        // personas genera 13 notificaciones irrelevantes por mensaje, y la
        // conversación que de verdad hace falta es entre el que toca el timbre
        // y el que abre la puerta. Además hereda el permiso naturalmente: quien
        // puede ver la postulación puede ver su chat.
        match /messages/{messageId} {

          allow get, list: if
            isAdmin()
            || isOwner(applicantId)
            || hasEarlyAccessInMatchGroup(matchId)
            || isMatchCreator(matchId);

          // Escriben los dos lados, siempre a nombre propio. `senderId` se
          // valida contra el uid real para que nadie escriba haciéndose pasar
          // por el otro.
          allow create: if
            isAuthenticated()
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && (
              isOwner(applicantId)
              || hasEarlyAccessInMatchGroup(matchId)
              || isMatchCreator(matchId)
            );

          // Un mensaje no se edita (sería reescribir lo que el otro ya leyó);
          // se borra el propio, o cualquiera si sos admin.
          allow update: if false;

          allow delete: if
            isAdmin()
            || (isAuthenticated() && resource.data.senderId == request.auth.uid);
        }

        // ── Sondeo consultivo ───────────────────────────────────────────────
        // Los que YA están anotados opinan (pulgar arriba/abajo) sobre quien
        // se postula. NO es vinculante: decide el organizador, esto solo le da
        // contexto. Va como subcolección de la postulación para que cada una
        // tenga su propio sondeo aislado.
        match /votes/{voterId} {

          allow get, list: if isAdmin() || isMemberOfMatchGroup(matchId);

          // Solo miembros del grupo del partido, y solo su propio voto.
          allow create, update: if
            isOwner(voterId)
            && isMemberOfMatchGroup(matchId)
            && request.resource.data.vote in ['up', 'down'];

          allow delete: if isOwner(voterId) || isAdmin();
        }
      }

      // ──────────────────────────────────────────────────────────────────────
      // PLAYER STATS
      // ──────────────────────────────────────────────────────────────────────
      match /playerStats/{userId} {

        allow read: if isAuthenticated();

        // Cargar stats individuales (goals/assists/team): CUALQUIER miembro del
        // grupo del partido, apenas termina el partido. El campo `mvp` queda
        // excluido de esta rama — solo lo escribe la Cloud Function
        // closeMvpVoting (Admin SDK) según el resultado de la votación; un
        // admin global puede corregir cualquier cosa a mano como escape
        // hatch de emergencia.
        // goals/assists deben ser enteros >= 0, y el userId del doc debe
        // coincidir con el docId (no se pueden cargar stats "a nombre de
        // otro" pisando el uid real).
        // El acumulador en users/{uid} lo escribe la Cloud Function
        // onPlayerStatsWritten (admin SDK), no el cliente.
        //
        // ⚠️ `team` se valida con get(): un jugador sin equipo asignado NO trae
        // el campo (Firestore descarta los `undefined` al escribir), y la
        // comparación directa `request.resource.data.team in ['A','B',null]`
        // daba FALSO sobre un campo ausente. Ese era el PERMISSION_DENIED que
        // solo sufrían los miembros comunes: un admin global se colaba igual
        // por la rama `|| isAdmin()`, así que el bug era invisible para el
        // dueño de la app y bloqueaba a todos los demás.
        //
        // Tampoco se exige ya `resultLocked == false`: cargar las estadísticas
        // es la tarea de todo el grupo apenas termina de jugar, y bloquearlas
        // a las 36hs dejaba al grupo sin poder registrar su propio partido.
        // El bloqueo se mantiene para la votación de MVP, que sí necesita
        // cerrarse para poder contar los votos.
        // ⚠️ `create` y `update` van SEPARADOS: en un create el documento no
        // existe todavía, así que `resource.data` es NULL y
        // `.diff(resource.data)` aborta la evaluación con "Null value error"
        // (un PERMISSION_DENIED indistinguible de una regla que deniega). En
        // el alta se comprueba directamente que `mvp` no venga en el payload.
        allow create: if
          (
            isMemberOfMatchGroup(matchId)
            && !('mvp' in request.resource.data)
            && statsPayloadIsValid(userId)
          )
          || isAdmin();

        allow update: if
          (
            isMemberOfMatchGroup(matchId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mvp'])
            && statsPayloadIsValid(userId)
          )
          || isAdmin();

        allow delete: if isAdmin();
      }

      // ──────────────────────────────────────────────────────────────────────
      // MVP VOTES
      // ──────────────────────────────────────────────────────────────────────
      // Un voto por jugador (docId = su uid), upsert mientras la votación esté
      // abierta. Nunca se puede votar a uno mismo. Solo se puede votar cuando
      // el partido está finalizado y la votación no fue cerrada todavía
      // (closeMvpVoting, Cloud Function, la cierra fijando mvpVotingClosed).
      match /mvpVotes/{voterId} {

        allow read: if isAuthenticated();

        allow create, update: if
          (isAdmin() || isMemberOfMatchGroup(matchId) || isGroupless(matchId))
          && isOwner(voterId)
          && matchData(matchId).status == 'finished'
          && matchData(matchId).get('mvpVotingClosed', false) == false
          && request.resource.data.votedForUserId is string
          && request.resource.data.votedForUserId != request.auth.uid
          && exists(/databases/$(database)/documents/matches/$(matchId)/registrations/$(request.resource.data.votedForUserId))
          && get(/databases/$(database)/documents/matches/$(matchId)/registrations/$(request.resource.data.votedForUserId)).data.get('isOnWaitlist', false) == false;

        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // GROUPS
    // ─────────────────────────────────────────────────────────────────────────
    match /groups/{groupId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated() && (

        // owner/admin del grupo
        isGroupAdmin(groupId)

        ||

        // memberCount: contador auxiliar de UI (evita leer toda la
        // subcolección members solo para mostrar "X miembros"). Solo puede
        // tocarlo quien ya sea miembro del grupo, O quien se está uniendo en
        // esta misma transacción (joinGroup/acceptJoinRequest crean el doc
        // de member y actualizan memberCount en la misma transacción; el
        // member doc todavía no existe cuando se evalúa esta regla, por eso
        // isOwner(request.auth.uid) cubre el alta propia). Como entero >= 0,
        // moviéndose de a UNO por vez (mismo patrón que currentPlayers en
        // matches) — antes cualquier autenticado, ni siquiera miembro, podía
        // pisarlo con cualquier valor.
        // ⚠️ BUG CORREGIDO: acá decía `isOwner(request.auth.uid)`, que compara
        // el uid del que llama CONSIGO MISMO — siempre true para cualquier
        // usuario autenticado. Eso anulaba el `isMemberOfGroup` de al lado y
        // dejaba que CUALQUIERA moviera el contador de CUALQUIER grupo.
        //
        // El caso legítimo que se quería cubrir es el alta propia: joinGroup y
        // acceptJoinRequest crean el doc de member y actualizan memberCount en
        // la MISMA transacción, y cuando se evalúa esta regla el member doc
        // todavía no existe. Se resuelve mirando el estado FUTURO
        // (getAfter) en vez de confiar en una comparación tautológica.
        (
          (
            isMemberOfGroup(groupId, request.auth.uid)
            || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
            || existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberCount', 'updatedAt'])
          && request.resource.data.memberCount is int
          && request.resource.data.memberCount >= 0
          && (
            request.resource.data.memberCount == resource.data.memberCount + 1
            || request.resource.data.memberCount == resource.data.memberCount - 1
            || (resource.data.memberCount == 0 && request.resource.data.memberCount == 0)
          )
        )
      );

      allow delete: if isAuthenticated()
                    && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role
                         == 'owner';

      // ──────────────────────────────────────────────────────────────────────
      // MEMBERS
      // ──────────────────────────────────────────────────────────────────────
      match /members/{userId} {

        allow read: if isAuthenticated();

        // Alta propia (joinGroup): solo puede autoasignarse role 'member' sin
        // OG — nunca 'owner'/'admin' ni og:true por su cuenta. La única
        // excepción es el creador del grupo dándose de alta como 'owner' en
        // el mismo flujo de createGroup (createdBy del grupo ya apunta a él).
        // Un owner/admin del grupo puede dar de alta a cualquiera con
        // cualquier role/og (invitar como admin, aceptar solicitud, etc.).
        allow create: if
          (
            isOwner(userId)
            && (
              (
                request.resource.data.role == 'member'
                && request.resource.data.get('og', false) == false
              )
              || (
                request.resource.data.role == 'owner'
                && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              )
            )
          )
          || isGroupAdmin(groupId);

        allow update: if isGroupAdmin(groupId);

        allow delete: if
          isOwner(userId)
          || isGroupAdmin(groupId);
      }

      // ──────────────────────────────────────────────────────────────────────
      // JOIN REQUESTS
      // ──────────────────────────────────────────────────────────────────────
      match /joinRequests/{userId} {

        allow read: if
          isOwner(userId)
          || isGroupAdmin(groupId);

        allow create: if isOwner(userId);

        allow update: if isGroupAdmin(groupId);

        allow delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // REPORTS (denuncias de usuarios)
    // ─────────────────────────────────────────────────────────────────────────
    // Mínimo viable de moderación, necesario antes de abrir la app a gente que
    // no se conoce (partidos públicos). No hay panel ni automatización: los
    // reportes se revisan a mano desde la consola de Firebase.
    //
    // Un reporte es una acusación sobre otra persona, así que NADIE lo lee
    // salvo un admin global — ni siquiera quien lo escribió. Si el denunciante
    // pudiera listarlos, sabría quién más denunció a quién; si el denunciado
    // pudiera leerlos, el reporte se vuelve una invitación a la represalia.
    match /reports/{reportId} {

      allow read, list: if isAdmin();

      // Cualquiera con cuenta puede reportar, pero solo en su propio nombre y
      // nunca a sí mismo. `reportedUserId` y `reason` son obligatorios para que
      // no queden reportes vacíos que no se pueden investigar.
      allow create: if
        isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 40
        && request.resource.data.get('details', '') is string
        && request.resource.data.get('details', '').size() <= 1000
        && request.resource.data.status == 'pending';

      // Solo un admin cambia el estado (revisado / desestimado). El
      // denunciante no puede editar lo que ya mandó — un reporte editable no
      // sirve como evidencia.
      allow update: if isAdmin();

      // Nunca se borran, ni por un admin: es el registro de la denuncia.
      // Se dan de baja cambiando `status`, igual que joinRequests.
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // VENUES (sedes / canchas)
    // ─────────────────────────────────────────────────────────────────────────
    match /venues/{venueId} {

      allow read: if isAuthenticated();

      // Crear: un admin global puede crear una sede GLOBAL (groupId null) o de
      // cualquier grupo. Un usuario común solo puede crear una sede de UN GRUPO
      // DEL QUE ES MIEMBRO — nunca una sede global.
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                      isAdmin()
                      || (
                        request.resource.data.groupId != null
                        && isMemberOfGroup(request.resource.data.groupId, request.auth.uid)
                      )
                    );

      // Editar (nombre/dirección/maps/notas): un admin global siempre puede.
      // Una sede de grupo la puede editar cualquier miembro de ESE grupo (no
      // solo el creador) — pero no se puede reasignar a otro grupo ni volverla
      // global salvo un admin, NI reasignar createdBy (antes un miembro podía
      // pisarlo con su propio uid y así ganar permiso de delete, que depende
      // de ser el creador). Una sede GLOBAL (groupId null) solo la edita un
      // admin — por eso no hay branch para "cualquier autenticado" acá.
      allow update: if isAdmin()
                    || (
                      isAuthenticated()
                      && resource.data.groupId != null
                      && isMemberOfGroup(resource.data.groupId, request.auth.uid)
                      && request.resource.data.groupId == resource.data.groupId
                      && request.resource.data.createdBy == resource.data.createdBy
                    );

      // Borrar (destructivo): solo quien la creó o un admin global.
      allow delete: if isAdmin()
                    || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }
  }
}