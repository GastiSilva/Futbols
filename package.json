{
  "name": "yasta",
  "version": "1.0.0",
  "description": "PWA para organizar partidos de fútbol amateur",
  "productName": "YASTA",
  "author": "",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.vue ./src",
    "format": "prettier --write \"**/*.{js,vue,scss,html,json}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.js\""
  },
  "dependencies": {
    "@quasar/extras": "^1.16.9",
    "firebase": "^10.14.1",
    "pinia": "^2.1.7",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@quasar/app-vite": "^2.6.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "prettier": "^3.2.5",
    "sass": "^1.77.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.10",
    "workbox-build": "7.0.x",
    "workbox-cacheable-response": "7.0.x",
    "workbox-core": "7.0.x",
    "workbox-expiration": "7.0.x",
    "workbox-precaching": "7.0.x",
    "workbox-routing": "7.0.x",
    "workbox-strategies": "7.0.x"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
